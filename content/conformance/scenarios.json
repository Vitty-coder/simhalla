      "zap": "fn run(ctx) {\n  let total = 0;\n  for t in ctx.targets {\n    let d = 40 + rand_int(30) + stat(ctx.caster, \"MAG\") * 0.2;\n    deal_damage(t, d, {\"damage_type\": \"magical\", \"element\": \"lightning\"});\n    total = total + d;\n    if chance(0.3) { apply_status(t, \"burn\", {\"duration\": 2}); }\n  }\n  metric(\"dano_script\", total);\n  let n = get_var(\"usos\");\n  if n == null { n = 0; }\n  set_var(\"usos\", n + 1);\n}\n",
      "brain": "fn decide(view) {\n  let best = null;\n  let bd = -1;\n  for la in view.legal_actions {\n    for t in la.targets {\n      let p = predict(view, la.ability_id, t);\n      if p.damage > bd { bd = p.damage; best = {ability: la.ability_id, target: t, reason: \"mejor\"}; }\n    }\n  }\n  if best == null { return {wait: true}; }\n  return best;\n}\n"
     },
