{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simhalla.artifact/1",
  "title": "Artefacto (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id"
  ],
  "properties": {
    "schema": {
      "const": "simhalla.artifact/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "name": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "modifiers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stat",
          "kind",
          "value"
        ],
        "properties": {
          "stat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "set",
              "flat",
              "pct_add",
              "mult",
              "min",
              "max"
            ]
          },
          "value": {
            "type": "number"
          },
          "priority": {
            "type": "integer"
          }
        }
      }
    },
    "abilities": {
      "$ref": "common.schema.json#/definitions/abilities"
    },
    "resources": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "$ref": "common.schema.json#/definitions/resource"
      }
    },
    "statuses": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "common.schema.json#/definitions/status"
      }
    },
    "summons": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "$ref": "common.schema.json#/definitions/summon_template"
      }
    },
    "ai_rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "common.schema.json#/definitions/ai_rule"
      }
    }
  }
}
