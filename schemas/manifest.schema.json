{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simhalla.manifest/1",
  "title": "Manifiesto de paquete (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "type",
    "name"
  ],
  "properties": {
    "schema": {
      "const": "simhalla.manifest/1"
    },
    "id": {
      "$ref": "common.schema.json#/definitions/package_id"
    },
    "version": {
      "$ref": "common.schema.json#/definitions/semver"
    },
    "type": {
      "enum": [
        "character",
        "abilities",
        "ai"
      ]
    },
    "name": {
      "$ref": "common.schema.json#/definitions/text"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "maxLength": 100
    },
    "min_engine_version": {
      "$ref": "common.schema.json#/definitions/semver"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/package_id"
          },
          "version": {
            "$ref": "common.schema.json#/definitions/constraint"
          }
        }
      }
    }
  }
}
